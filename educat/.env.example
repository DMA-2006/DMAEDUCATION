# Copie ce fichier en ".env" (même dossier) et remplis les valeurs.
# Le fichier .env contient des secrets : ne le partage pas et ne le mets pas sur Git.

# --- Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données PostgreSQL ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- IA (Groq) : obligatoire, le serveur ne démarre pas sans cette clé ---
GROQ_API_KEY=

# --- Connexion avec Google (facultatif) : ID client OAuth, se termine par .apps.googleusercontent.com ---
GOOGLE_CLIENT_ID=

# --- Envoi des codes OTP (facultatif) ---
# Option 1, obligatoire sur Render gratuit (le SMTP y est bloqué) : Brevo
#   BREVO_API_KEY = clé API Brevo (commence par xkeysib-)
#   EMAIL_EXPEDITEUR = adresse d'expédition validée dans Brevo
BREVO_API_KEY=
EMAIL_EXPEDITEUR=
# Option 2, en local seulement : Gmail, adresse + mot de passe d'application (16 lettres)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Si rien n'est rempli, le code s'affiche dans le terminal de Django.
