# Copie ce fichier en ".env" (même dossier) et remplis les valeurs.
# Le fichier .env contient des secrets : ne le partage pas et ne le mets pas sur Git.

# --- Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données PostgreSQL ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- IA (Groq) : obligatoire, le serveur ne démarre pas sans cette clé ---
GROQ_API_KEY=

# --- Connexion avec Google (facultatif) : ID client OAuth, se termine par .apps.googleusercontent.com ---
GOOGLE_CLIENT_ID=

# --- Envoi des codes OTP par Gmail (facultatif) : adresse + mot de passe d'application (16 lettres) ---
# Si ces deux lignes sont vides, le code s'affiche dans le terminal de Django.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
